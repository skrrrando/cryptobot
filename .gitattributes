# Auto detect text files and perform LF normalization
* text=auto

# dashboard.html and index.html are auto-generated by engine.py from data/state.json
# on every hourly run. They have no unique source data of their own, so if a local
# push and the hourly bot's push race each other, always keep whichever side we're
# merging INTO (git will just regenerate correct, fresh content on the very next
# hourly run anyway) instead of asking for manual conflict resolution.
dashboard.html merge=ours
index.html merge=ours
